default_platform(:ios)

platform :ios do
  desc "Build the app for simulator"
  lane :build do
    gym(
      scheme: "TruckRouteCalculator",
      configuration: "Debug",
      destination: "generic/platform=iOS Simulator",
      clean: true,
      skip_package_ipa: true,
      skip_archive: true
    )
  end

  desc "Run unit tests"
  lane :test do
    scan(
      scheme: "TruckRouteCalculator",
      devices: ["iPhone 17 Pro"],
      configuration: "Debug",
      clean: true,
      code_coverage: true
    )
  end

  desc "Run UI tests and generate report"
  lane :ui_test do |options|
    # Clear previous results
    FileUtils.rm_rf("../test_output")

    # Run UI tests
    scan(
      scheme: "TruckRouteCalculator",
      devices: [options[:device] || "iPhone 17 Pro"],
      only_testing: ["TruckRouteCalculatorUITests"],
      result_bundle: true,
      output_directory: "./test_output",
      output_types: "html,junit",
      buildlog_path: "./test_output/logs",
      clean: true
    )

    # Generate summary
    puts "\n" + "=" * 70
    puts "UI TEST REPORT"
    puts "=" * 70
    puts "Results saved to: ./test_output/"
    puts "Open test_output/report.html for detailed results"
    puts "Screenshots saved in test attachments"
    puts "=" * 70 + "\n"
  end

  desc "Run all tests (unit + UI)"
  lane :test_all do
    test
    ui_test
  end

  desc "Build and test"
  lane :build_and_test do
    build
    test
  end

  desc "Push a new beta build to TestFlight"
  lane :beta do |options|
    increment_build_number(
      xcodeproj: "TruckRouteCalculator.xcodeproj"
    )
    build_app(
      scheme: "TruckRouteCalculator",
      export_method: "app-store",
      clean: true,
      export_options: {
        provisioningProfiles: {
          "com.pivotallift.TruckRouteCalculator" => "TruckRouteCalculator AppStore"
        }
      }
    )
    api_key = app_store_connect_api_key(
      key_id: "FLU3XD48JB",
      issuer_id: "a6c067d7-5b9a-45cc-a189-299e50ed0255",
      key_filepath: File.expand_path("~/.appstoreconnect/private_keys/AuthKey_FLU3XD48JB.p8")
    )
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: options[:wait] != true,
      changelog: options[:changelog] || "Bug fixes and improvements",
      beta_app_feedback_email: "helpnow@pivotallift.com",
      notify_external_testers: options[:notify] == true
    )
  end

  desc "Upload metadata to App Store Connect (no binary)"
  lane :metadata do
    deliver(
      skip_binary_upload: true,
      skip_screenshots: true,
      force: true
    )
  end

  desc "Upload screenshots to App Store Connect"
  lane :screenshots do
    deliver(
      skip_binary_upload: true,
      skip_metadata: true,
      force: true
    )
  end

  desc "Push a new release to the App Store"
  lane :release do |options|
    increment_build_number(
      xcodeproj: "TruckRouteCalculator.xcodeproj"
    )
    build_app(
      scheme: "TruckRouteCalculator",
      export_method: "app-store",
      clean: true,
      export_options: {
        provisioningProfiles: {
          "com.pivotallift.TruckRouteCalculator" => "TruckRouteCalculator AppStore"
        }
      }
    )
    api_key = app_store_connect_api_key(
      key_id: "FLU3XD48JB",
      issuer_id: "a6c067d7-5b9a-45cc-a189-299e50ed0255",
      key_filepath: File.expand_path("~/.appstoreconnect/private_keys/AuthKey_FLU3XD48JB.p8")
    )
    upload_to_app_store(
      api_key: api_key,
      force: true,
      skip_metadata: false,
      skip_screenshots: options[:skip_screenshots] != false,
      submit_for_review: options[:submit] == true,
      automatic_release: options[:auto_release] == true,
      precheck_include_in_app_purchases: false,
      run_precheck_before_submit: false,
      submission_information: {
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false,
        export_compliance_encryption_updated: false
      }
    )
  end

  desc "Submit existing build for App Store review"
  lane :submit do
    deliver(
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: true,
      submit_for_review: true,
      automatic_release: false,
      force: true,
      submission_information: {
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false,
        export_compliance_encryption_updated: false
      }
    )
  end

  desc "Add external tester to TestFlight"
  lane :add_tester do |options|
    pilot(
      email: options[:email],
      groups: [options[:group] || "Beta Testers"]
    )
  end

  desc "List TestFlight testers"
  lane :testers do
    pilot(list: true)
  end

  desc "Lint Swift code"
  lane :lint do
    swiftlint(
      mode: :lint,
      executable: "swiftlint",
      reporter: "emoji"
    )
  end

  desc "Fix SwiftLint warnings"
  lane :lint_fix do
    swiftlint(
      mode: :autocorrect,
      executable: "swiftlint"
    )
  end
end
